# Copy to .env (repo root, for seed importer + RLS probe) and web/.env.local (for Vite).
# Never commit real values. .env* is gitignored except this file.
#
# Where to find each value (Supabase): Project → Settings → API
#   1. Project URL                → SUPABASE_URL / VITE_SUPABASE_URL
#   2. Project API keys → anon    → SUPABASE_ANON_KEY / VITE_SUPABASE_ANON_KEY
#   3. Project API keys → service_role → SUPABASE_SERVICE_ROLE_KEY  (server only!)
#
# service_role bypasses RLS: it is used ONLY by the seed importer and the RLS probe.
# It must never appear in web/, in commits, or in chat.

# --- web/ (Vite) — used by Vite dev server at build time ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key: safe to ship, RLS enforces access>

# --- seed importer + RLS probe (root .env) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon public key: safe to ship, RLS enforces access>
SUPABASE_SERVICE_ROLE_KEY=<service role key: bypasses RLS, server only, never commit>
