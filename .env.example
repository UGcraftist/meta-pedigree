# Copy to .env (root, for the seed importer) / web/.env.local (for Vite).
# Never commit real values. .env* is gitignored except this file.

# --- web/ (Vite) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key, safe to ship: RLS enforces access>

# --- seed importer + RLS probe (root .env) ---
# Project URL and keys: Supabase → Project Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon public key, safe to ship: RLS enforces access>
# service_role bypasses RLS; seed import and the RLS probe only. Never in web/, never committed.
SUPABASE_SERVICE_ROLE_KEY=<service role key>
