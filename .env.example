# Copy to .env (root, for the seed importer) / web/.env.local (for Vite).
# Never commit real values. .env* is gitignored except this file.

# --- web/ (Vite) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key, safe to ship: RLS enforces access>

# --- seed importer (Supabase → Connect → Session pooler URI) ---
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- optional: apply migrations without psql (Account → Access Tokens) ---
SUPABASE_ACCESS_TOKEN=
